// Lark Grammar for RDTL - Verification and Test Generation
// ===========================================================
//
// PURPOSE:
//   This grammar is used for:
//   1. Structure verification (defining valid RDTL syntax)
//   2. Parser agreement testing (comparing Lark vs manual parser)
//   3. Test-case generation (via Hypothesis + Lark, see test_property_based.py
//      and test_grammar_with_django.py)
//
// SOUNDNESS, NOT COMPLETENESS:
//   This grammar is intentionally a *subset* of what the hand-written RDTL
//   parser accepts. Its job is to GENERATE templates that are guaranteed to be
//   valid, so the property-based tests can assert that every generated template
//   parses (and that Django agrees). It does NOT try to describe every legal
//   template - e.g. it only emits a single canonical whitespace form, a handful
//   of HTML tags, and library/tag constructs that plain Django accepts.
//
// WHY WHITESPACE IS EXPLICIT (no `%ignore WS`):
//   An earlier version used `%ignore WS`, which let Hypothesis generate strings
//   the real parser rejects:
//     - merged word tokens: `{%ifx%}`, `with url=...` -> `withurl=...`
//     - whitespace where the lexer forbids it: `< div>`, `<br / >`
//   Both come from whitespace being freely insertable/removable. Here WS is a
//   real, required terminal placed only where the parser allows it. The test
//   harness binds WS to a single space (explicit={"WS": st.just(" ")}), so
//   generation always emits canonical, parseable spacing.
//
//   To keep the grammar LALR(1) (the tests build it with parser="lalr"), binary
//   operators bake their surrounding spaces into the terminal itself (e.g.
//   " == ", " and ", " | "). That way the parser decides what follows an operand
//   on a distinct terminal rather than on a shared, ambiguous WS token.
//
// WHY HTML TAGS ARE ENUMERATED:
//   A context-free grammar cannot require a closing tag name to match its
//   opening tag name, so a generic `"<" NAME ... "</" NAME ">"` rule happily
//   generates `<b></a>`, which the parser correctly rejects. Listing a small set
//   of concrete tags makes open and close literally the same string, so every
//   generated element is well-formed.
//
// LIMITATION - NESTED QUOTES:
//   This grammar cannot express the nested-quote feature, e.g.
//       <div title="{% trans "that's all folks" %}">
//   The manual RDTL lexer uses STATEFUL parsing for that; Lark's regex-based
//   lexing cannot track "inside attribute -> inside template -> inside string".
//   Such cases are covered by the custom Hypothesis strategies in
//   test_property_based.py instead.
//
// See THEORY.md for the CFG vs context-sensitive discussion.

?start: document

document: element*

?element: html_element
        | template_variable
        | template_block
        | template_single_tag
        | TEXT

// ----------------------------------------------------------------------------
// HTML elements
// ----------------------------------------------------------------------------
// Tags are enumerated so the open and close names always match (see header).

html_element: div_element
            | p_element
            | span_element
            | section_element
            | li_element
            | void_element

div_element:     "<div" attributes ">" element* "</div>"
p_element:       "<p" attributes ">" element* "</p>"
span_element:    "<span" attributes ">" element* "</span>"
section_element: "<section" attributes ">" element* "</section>"
li_element:      "<li" attributes ">" element* "</li>"

void_element: "<br" attributes "/>"
            | "<hr" attributes "/>"
            | "<img" attributes "/>"
            | "<input" attributes "/>"

// Each attribute is preceded by whitespace; the name hugs "<tagname" via that
// space, and there is never a space after "<" or inside "/>".
attributes: (WS attribute)*
attribute: ATTR_NAME "=" attr_value
         | ATTR_NAME

attr_value: STRING

// ----------------------------------------------------------------------------
// Template variables:  {{ expr }}  /  {{ expr | filter }}
// ----------------------------------------------------------------------------
template_variable: "{{" WS expression_or_filtered WS "}}"

expression_or_filtered: expression filter_chain?

filter_chain: (FILTER_PIPE filter)+
filter: IDENTIFIER filter_args?
filter_args: ":" filter_arg ("," filter_arg)*
filter_arg: STRING | NUMBER | IDENTIFIER

// ----------------------------------------------------------------------------
// Template blocks
// ----------------------------------------------------------------------------
template_block: if_block
              | for_block
              | with_block

if_block: if_open element* elif_part* else_part? if_close

if_open:   "{%" WS "if" WS condition WS "%}"
elif_part: "{%" WS "elif" WS condition WS "%}" element*
else_part: "{%" WS "else" WS "%}" element*
if_close:  "{%" WS "endif" WS "%}"

for_block: for_open element* empty_part? for_close

for_open:   "{%" WS "for" WS loop_vars WS "in" WS expression WS "%}"
loop_vars:  IDENTIFIER ("," WS IDENTIFIER)*
empty_part: "{%" WS "empty" WS "%}" element*
for_close:  "{%" WS "endfor" WS "%}"

with_block: with_open element* with_close

with_open:       "{%" WS "with" (WS with_assignment)+ WS "%}"
with_assignment: IDENTIFIER "=" expression_or_filtered
with_close:      "{%" WS "endwith" WS "%}"

// ----------------------------------------------------------------------------
// Single (self-closing) template tags
// ----------------------------------------------------------------------------
// Only tags that plain Django accepts without a preceding {% load %} are
// generated. (The {% static %} tag, for instance, requires {% load static %}
// first, so Django rejects it on its own - we therefore don't generate it,
// even though the RDTL parser handles it fine.)

template_single_tag: include_tag
                   | load_tag
                   | extends_tag
                   | url_tag
                   | cycle_tag
                   | csrf_token_tag
                   | debug_tag

include_tag: "{%" WS "include" WS STRING (WS "with" (WS kwarg)+)? WS "%}"

kwarg: IDENTIFIER "=" expression

// Django only knows a fixed set of bundled tag libraries; loading an unknown
// one is a syntax error, so generation is restricted to real library names.
load_tag: "{%" WS "load" (WS LIBRARY)+ WS "%}"
LIBRARY: "static" | "i18n" | "l10n" | "tz" | "cache"

extends_tag: "{%" WS "extends" WS STRING WS "%}"

url_tag: "{%" WS "url" WS url_target (WS kwarg)* (WS "as" WS IDENTIFIER)? WS "%}"
url_target: STRING | IDENTIFIER

cycle_tag: "{%" WS "cycle" (WS cycle_value)+ (WS "as" WS IDENTIFIER)? WS "%}"
cycle_value: STRING | NUMBER | IDENTIFIER

csrf_token_tag: "{%" WS "csrf_token" WS "%}"

debug_tag: "{%" WS "debug" WS "%}"

// ----------------------------------------------------------------------------
// Expressions and conditions
// ----------------------------------------------------------------------------
// Django uses dot notation only (user.name, items.0); bracket notation and
// spaces around dots are invalid, so LOOKUP hugs the dot with no whitespace.

expression: IDENTIFIER LOOKUP*
          | STRING
          | NUMBER

// Boolean/comparison operators carry their own surrounding spaces so the parser
// never has to disambiguate on a bare WS token (keeps the grammar LALR(1)).
condition: bool_term (BOOL_OP bool_term)*
bool_term: NOT? comparand (COMPARATOR comparand)?
comparand: expression_or_filtered

NOT: "not "
BOOL_OP: " and " | " or "
COMPARATOR: " == " | " != " | " <= " | " >= " | " < " | " > " | " in " | " is not " | " is "
FILTER_PIPE: " | "

// ----------------------------------------------------------------------------
// Terminals
// ----------------------------------------------------------------------------
ATTR_NAME: /[a-zA-Z_@:][-a-zA-Z0-9_:@.]*/
IDENTIFIER: /[a-zA-Z_][a-zA-Z0-9_]*/
NUMBER: /-?\d+(\.\d+)?/

// Strings used inside template tags must not contain characters that would let
// a re-lexer (RDTL's or Django's) mistake their contents for tag/variable
// delimiters or operators: % { } | < > and quotes/backslash.
STRING: /"[^"%{}|<>\\]*"/ | /'[^'%{}|<>\\]*'/

// Lookup: a dot immediately followed by an identifier or a numeric index.
LOOKUP: /\.[a-zA-Z_][a-zA-Z0-9_]*/
      | /\.\d+/

// Plain text between markup. Excludes "<" and "{" so generated text can never
// accidentally open an HTML or template construct.
TEXT: /[^<{]+/

// Required whitespace. The test harness binds this to a single space.
WS: /[ \t\r\n]+/
